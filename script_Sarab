local function SaveCurrentSpot()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        State.PreviousCFrame = hrp.CFrame
    end
end

local function TeleportCFrame(cf, label, savePrev, notifyFn)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and cf then
        if savePrev ~= false then
            State.PreviousCFrame = hrp.CFrame
        end
        hrp.CFrame = cf + Vector3.new(0, 3, 0)
        if notifyFn then
            notifyFn("تم الانتقال", "إلى: " .. tostring(label), 3)
        end
    end
end

local function FindByKeywords(keywords)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local bestPart, bestDist = nil, math.huge

    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("BasePart") or desc:IsA("Model") then
            local part = desc:IsA("BasePart") and desc or desc:FindFirstChildWhichIsA("BasePart", true)
            if part and part.Parent and not Players:GetPlayerFromCharacter(part.Parent) then
                local combined = string.lower(desc.Name .. " " .. part.Name)
                for _, prompt in ipairs(desc:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        combined = combined .. " " .. string.lower(prompt.ObjectText .. " " .. prompt.ActionText)
                    end
                end
                for _, kw in ipairs(keywords) do
                    if string.find(combined, string.lower(kw), 1, true) then
                        local d = hrp and (part.Position - hrp.Position).Magnitude or 0
                        if d < bestDist then
                            bestDist = d
                            bestPart = part
                        end
                        break
                    end
                end
            end
        end
    end
    return bestPart
end

local function TeleportKeywords(keywords, displayName, fallbackNearest, notifyFn)
    local found = FindByKeywords(keywords)
    if found then
        TeleportCFrame(found.CFrame, displayName, true, notifyFn)
        return true
    end

    if fallbackNearest then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local nearPart, nearDist = nil, math.huge
            for _, p in ipairs(Workspace:GetDescendants()) do
                if p:IsA("ProximityPrompt") and p.Enabled and p.Parent then
                    local part = p.Parent:IsA("BasePart") and p.Parent or p.Parent:FindFirstChildWhichIsA("BasePart", true)
                    if part then
                        local d = (part.Position - hrp.Position).Magnitude
                        if d > 5 and d < nearDist then
                            nearDist = d
                            nearPart = part
                        end
                    end
                end
            end
            if nearPart then
                TeleportCFrame(nearPart.CFrame, displayName .. " (أقرب غرض)", true, notifyFn)
                return true
            end
        end
    end

    if notifyFn then
        notifyFn("تنبيه", "لم يتم العثور على (" .. displayName .. ") حالياً", 3)
    end
    return false
end

local function DeleteDoorsByKeywords(keywords, label, notifyFn)
    local removed = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local nameLower = string.lower(obj.Name)
            for _, kw in ipairs(keywords) do
                if string.find(nameLower, string.lower(kw), 1, true) then
                    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
                    if part then
                        pcall(function()
                            part.CanCollide = false
                            part.Transparency = 1
                        end)
                        removed = removed + 1
                    end
                    break
                end
            end
        end
    end
    if notifyFn then
        notifyFn("الأبواب", label .. " (" .. tostring(removed) .. ")", 3)
    end
end

