local function SendAlert(title, content, duration)
    if Fluent and Fluent.Notify then
        pcall(function()
            Fluent:Notify({
                Title = title,
                Content = content,
                Duration = duration or 3
            })
        end)
    end
end

-- دالة تحسين البتن العائم (سحب سلس + نقرة دقيقة لفتح/إغلاق الواجهة)
local function AttachSmartMobileButton(onToggleClick, labelText)
    pcall(function()
        if CoreGui:FindFirstChild("SarabFluentMobileBtn") then
            CoreGui.SarabFluentMobileBtn:Destroy()
        end
        if LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("SarabFluentMobileBtn") then
            LocalPlayer.PlayerGui.SarabFluentMobileBtn:Destroy()
        end
    end)

    local MobileGui = Instance.new("ScreenGui")
    MobileGui.Name = "SarabFluentMobileBtn"
    MobileGui.ResetOnSpawn = false
    MobileGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local ok = pcall(function()
        MobileGui.Parent = CoreGui
    end)
    if not ok then
        MobileGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end

    local btn = Instance.new("TextButton")
    btn.Name = "SmartToggleBtn"
    btn.Size = UDim2.new(0, 56, 0, 56)
    btn.Position = UDim2.new(0.03, 0, 0.25, 0)
    btn.BackgroundColor3 = Color3.fromRGB(24, 24, 28)
    btn.Text = labelText or "Fluent"
    btn.TextColor3 = Color3.fromRGB(240, 240, 245)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.AutoButtonColor = true
    btn.Active = true
    btn.Parent = MobileGui

    local cr = Instance.new("UICorner")
    cr.CornerRadius = UDim.new(0, 14)
    cr.Parent = btn

    local st = Instance.new("UIStroke")
    st.Color = Color3.fromRGB(70, 70, 80)
    st.Thickness = 1.4
    st.Parent = btn

    local dragging = false
    local moved = false
    local dragInput = nil
    local dragStart = nil
    local startPos = nil

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = btn.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    local wasMoved = moved
                    dragging = false
                    dragInput = nil
                    if not wasMoved and onToggleClick then
                        onToggleClick()
                    end
                end
            end)
        end
    end)

    btn.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            if delta.Magnitude > 7 then
                moved = true
            end
            btn.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)

    return btn
end

